{
  "name": "invoice-generation",
  "private": true,
  "version": "1.0.0",
  "description": "Static invoice generator with unit + Playwright E2E tests",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test --project=chromium --project=mobile-chrome",
    "test:e2e:all": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "serve": "npx --yes serve . -l 4173"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "pdf-parse": "^1.1.1"
  }
}
